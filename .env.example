# Copie ce fichier en `.env` et colle tes cles. Le fichier .env est ignore par git.

# Fournisseur par defaut (openrouter | groq | openai) — voir les reglages.
# Une seule cle suffit : celle du fournisseur choisi.

OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optionnel : Groq en direct est nettement plus rapide (~1 s au lieu de ~2-3 s)
# car OpenRouter ajoute un saut reseau. Le palier gratuit Groq suffit largement
# pour de la dictee. Cree une cle sur https://console.groq.com/keys
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optionnel
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
